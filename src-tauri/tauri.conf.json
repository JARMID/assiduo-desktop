{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Assiduo",
  "version": "1.0.0",
  "identifier": "dz.insfp.assiduo",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Assiduo - Gestion d'Assiduité (INSFP Ouled Fayet)",
        "width": 1280,
        "height": 840,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://afwqtjmwklmoqntnvgww.supabase.co https://integrate.api.nvidia.com https://api.twilio.com https://app.windmill.dev https://api.pwnedpasswords.com https://api.qrserver.com; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
